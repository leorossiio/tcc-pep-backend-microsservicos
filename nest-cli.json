{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "root": "apps",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true
  },
  "projects": {
    "api-gateway": {
      "type": "application",
      "root": "apps/api-gateway",
      "entryFile": "main",
      "sourceRoot": "apps/api-gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api-gateway/tsconfig.app.json"
      }
    },
    "ms-atendimentos": {
      "type": "application",
      "root": "apps/ms-atendimentos",
      "entryFile": "main",
      "sourceRoot": "apps/ms-atendimentos/src",
      "compilerOptions": {
        "tsConfigPath": "apps/ms-atendimentos/tsconfig.app.json"
      }
    },
    "ms-auditoria": {
      "type": "application",
      "root": "apps/ms-auditoria",
      "entryFile": "main",
      "sourceRoot": "apps/ms-auditoria/src",
      "compilerOptions": {
        "tsConfigPath": "apps/ms-auditoria/tsconfig.app.json"
      }
    },
    "ms-consultas-laudos": {
      "type": "application",
      "root": "apps/ms-consultas-laudos",
      "entryFile": "main",
      "sourceRoot": "apps/ms-consultas-laudos/src",
      "compilerOptions": {
        "tsConfigPath": "apps/ms-consultas-laudos/tsconfig.app.json"
      }
    },
    "ms-historico-clinicos": {
      "type": "application",
      "root": "apps/ms-historico-clinicos",
      "entryFile": "main",
      "sourceRoot": "apps/ms-historico-clinicos/src",
      "compilerOptions": {
        "tsConfigPath": "apps/ms-historico-clinicos/tsconfig.app.json"
      }
    },
    "ms-medicos": {
      "type": "application",
      "root": "apps/ms-medicos",
      "entryFile": "main",
      "sourceRoot": "apps/ms-medicos/src",
      "compilerOptions": {
        "tsConfigPath": "apps/ms-medicos/tsconfig.app.json"
      }
    },
    "ms-pacientes": {
      "type": "application",
      "root": "apps/ms-pacientes",
      "entryFile": "main",
      "sourceRoot": "apps/ms-pacientes/src",
      "compilerOptions": {
        "tsConfigPath": "apps/ms-pacientes/tsconfig.app.json"
      }
    }
  }
}